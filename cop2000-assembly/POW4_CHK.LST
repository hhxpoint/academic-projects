00 7080         MOV A,80H
02 20FF         AND A,#255
04 A42F         JZ NOTP4
06 6001         SUB A,#01H
08 A435         JZ YESP4
            DIVLOOP:
0A 7080         MOV A,80H
0C 0500         MOV R1,#00H
            DBY4:
0E 6004         SUB A,#04H
10 801A         JC DEND
12 09           MOV A,R1
13 5001         ADD A,#01H
15 0D           MOV R1,A
16 A41A         JZ DEND
18 780E         JMP DBY4
            DEND:
1A 801E         JC DREST
1C 7820         JMP DCHK
            DREST:
1E 5004         ADD A,#04H
            DCHK:
20 20FF         AND A,#255
22 A426         JZ DCHK_CONT
24 782F         JMP NOTP4
            DCHK_CONT:
26 09           MOV A,R1
27 6001         SUB A,#01H
29 A435         JZ YESP4
2B 1C80         MOV 80H,A
2D 780A         JMP DIVLOOP
            NOTP4:
2F 1000         MOV A,#00H
31 1C81         MOV 81H,A
33 7839         JMP FIN
            YESP4:
35 1001         MOV A,#01H
37 1C81         MOV 81H,A
            FIN:
39 8C           NOP
3A 783A         JMP $
            
