            ; ============= 初始化与边界处理模块 =============
00 7080         MOV A, 80H          ; 将待判断的数字 N 从主存 80H 读入累加器 A
02 0C           MOV R0, A           ; 将 N 备份到寄存器 R0 中
            
                ; 边界检查 1：判断 N 是否 < 2
03 6002         SUB A, #02H         ; A = N - 2
05 8020         JC NOT_PRIME        ; 如果产生借位，说明 N < 2 (即0或1)，跳至非质数分支
            
                ; 边界检查 2：判断 N 是否 == 2
07 A426         JZ IS_PRIME         ; 如果结果为 0，说明 N == 2，跳至质数分支
            
                ; 对于 N > 2 的情况，初始化除数 i
09 0502         MOV R1, #02H        ; R1 作为除数寄存器，从 2 开始
            
            ; ============= 外层循环：递增除数 i =============
            OUTER_LOOP:
0B 08           MOV A, R0           ; 读入原数 N
0C 59           SUB A, R1           ; 比较 N 和当前的除数 i
0D A426         JZ IS_PRIME         ; 如果 N == i，说明 2 到 N-1 都不能整除它，判定为质数！
            
0F 08           MOV A, R0           ; 重新将 N 装入 A
10 0E           MOV R2, A           ; R2 作为模拟取模时的"余数暂存器"，初始化为 N
            
            ; ============= 内层循环：连续减法模拟取模 N % i =============
            MOD_LOOP:
11 0A           MOV A, R2           ; 读入当前剩余的数
12 59           SUB A, R1           ; 减去当前的除数 i
13 A420         JZ NOT_PRIME        ; 若减法结果刚好为 0 (整除)，判定为非质数！
15 801A         JC NEXT_I           ; 若不够减了(产生借位)，说明有不为0的余数，当前 i 无法整除 N
            
17 0E           MOV R2, A           ; 够减且不为0，将减后的新余数存回 R2
18 7811         JMP MOD_LOOP        ; 继续连减
            
            ; ============= 步进处理 =============
            NEXT_I:
1A 09           MOV A, R1           ; 将除数 i 送入 A
1B 5001         ADD A, #01H         ; 除数 i 加 1
1D 0D           MOV R1, A           ; 存回 R1 寄存器
1E 780B         JMP OUTER_LOOP      ; 跳转回外层循环进行下一轮试除
            
            ; ============= 结果输出模块 =============
            NOT_PRIME:
20 1000         MOV A, #00H         ; 若非质数，输出标志 00H
22 1C81         MOV 81H, A          ; 写入主存 81H
24 782A         JMP END_PROG        ; 跳转至结束
            
            IS_PRIME:
26 1001         MOV A, #01H         ; 若为质数，输出标志 01H
28 1C81         MOV 81H, A          ; 写入主存 81H
            
            ; ============= 程序停机 =============
            END_PROG:
2A 8C           NOP
2B 782A         JMP END_PROG        ; 死循环锁死程序状态，防止PC跑飞
            
