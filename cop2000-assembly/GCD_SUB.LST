00 100C     MOV A, #0CH
02 1C80     MOV 80H, A
04 1008     MOV A, #08H
06 1C81     MOV 81H, A
            LOOP:
08 7080         MOV A, 80H
0A 6481         SUB A, 81H
0C A41C         JZ DONE
0E 8014         JC SWAP
10 1C80         MOV 80H, A
12 7808         JMP LOOP
            SWAP:
14 7081         MOV A, 81H
16 6480         SUB A, 80H
18 1C81         MOV 81H, A
1A 7808         JMP LOOP
            DONE:
1C 7080         MOV A, 80H
1E 1C82         MOV 82H, A
            END:
