00 0406     MOV R0, #06H    ; 存放乘数a（6 → 0110）
02 0502     MOV R1, #02H    ; 存放乘数b（2 → 0010）
04 0600     MOV R2, #00H    ; 存放乘法结果（初始为0）
            LOOP1:
06 08        MOV A, R0        ; 将R0中的数送到A（检测乘数是否为0）
07 20FF      AND A, #255      ; 判断A是否为0（设置零标志Z）
09 A42A      JZ LOOP4         ; 若R0=0，直接跳转到结束（结果为0）
            
0B 09        MOV A, R1        ; 将R1中的数送到A（检测被乘数是否为0）
0C 20FF      AND A, #255      ; 判断A是否为0（设置零标志Z）
0E A42A      JZ LOOP4         ; 若R1=0，直接跳转到结束（结果为0）
            
10 08        MOV A, R0        ; 将R0中的数送到A（检测最低位LSB）
11 2001      AND A, #01H      ; 提取A的最低位（LSB）
13 A420      JZ LOOP2         ; 若LSB=0，跳转到LOOP2（仅移位，不累加）
            
             ; LSB=1时的处理：右移乘数 + 累加被乘数 + 左移被乘数
15 08        MOV A, R0
16 40        RR A             ; 乘数R0右移1位（逻辑右移，丢弃LSB）
17 0C        MOV R0, A
            
18 0A        MOV A, R2
19 49        ADD A, R1        ; 结果R2 += 当前被乘数R1（累加操作）
1A 0E        MOV R2, A
            
1B 09        MOV A, R1
1C 44        RL A             ; 被乘数R1左移1位（逻辑左移，位权放大×2）
1D 0D        MOV R1, A
            
1E 7806      JMP LOOP1        ; 返回循环开始，处理下一位
            
            LOOP2:           ; LSB=0时的处理：仅移位，不累加
20 08        MOV A, R0
21 40        RR A             ; 乘数R0右移1位
22 0C        MOV R0, A
            
23 09        MOV A, R1
24 44        RL A             ; 被乘数R1左移1位
25 0D        MOV R1, A
            
26 7806      JMP LOOP1        ; 返回循环开始，处理下一位
            
            LOOP3:
28 7828      JMP LOOP3        ; 死循环（程序终止）
            
            LOOP4:           ; 结束标签
             END              ; 程序结束
