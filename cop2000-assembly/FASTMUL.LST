            ; ============= 初始化模块 =============
00 1002     MOV A, #02H        ; 将底数 8 存入累加器 A
02 1C80     MOV 80H, A         ; 将 A 中的值存入主存地址 80H（作为底数）
04 1003     MOV A, #03H        ; 将指数 2 存入累加器 A
06 1C81     MOV 81H, A         ; 将 A 中的值存入主存地址 81H（作为指数）
08 0701     MOV R3, #01H       ; 将结果初始化为 1，R3 保存最终运算结果
            ; ============= 快速幂主循环 =============
            LOOP1:                             ; 主循环开始
0A 7081         MOV A, 81H                    ; 将主存地址 81H 的值送入累加器 A（当前指数）
0C 20FF         AND A, #255                   ; 判断 A 是否为 0（即指数是否为 0）
0E A475         JZ LOOPEND                    ; 如果指数为 0，直接跳转到结束
            
10 7081         MOV A, 81H                    ; 再次将主存地址 81H 的值送入 A
12 2001         AND A, #01H                   ; 判断最低位是否为 1（即指数奇偶性）
14 A449         JZ LOOP2                      ; 如果为 0（偶数），跳转至 LOOP2（不乘 ans）
            
                ; 当前指数为奇数 → ans *= pos
16 0B           MOV A, R3                     ; 将 R3 中的结果送入 A
17 0C           MOV R0, A                     ; 将 A 中的值送入寄存器 R0
18 9180         MOV R1, 80H                   ; 将主存地址 80H 的值送入 R1（当前底数）
1A 0600         MOV R2, #00H                  ; 初始化 R2 寄存器用于存放乘法中间结果
            ; ============= 乘法子程序（R0 × R1 → R2） =============
            LOOP6:                             ; 运算结果存放在 R2 中
1C 08           MOV A, R0
1D 20FF         AND A, #255
1F A43E         JZ LOOP8                      ; 如果 R0 为 0，跳转至 LOOP8（乘法结束）
            
21 09           MOV A, R1
22 20FF         AND A, #255
24 A43E         JZ LOOP8                      ; 如果 R1 为 0，跳转至 LOOP8（乘法结束）
            
26 08           MOV A, R0
27 2001         AND A, #01H                   ; 检查 R0 最低位
29 A436         JZ LOOP7                      ; 最低位为 0，跳转至 LOOP7（不加）
            
2B 08           MOV A, R0
2C 40           RR A                          ; R0 右移一位
2D 0C           MOV R0, A
            
2E 0A           MOV A, R2
2F 49           ADD A, R1                     ; R2 += R1
30 0E           MOV R2, A
            
31 09           MOV A, R1
32 44           RL A                          ; R1 左移一位
33 0D           MOV R1, A
            
34 781C         JMP LOOP6                     ; 跳转回 LOOP6 继续运算
            LOOP7:
36 08           MOV A, R0
37 40           RR A                          ; R0 右移一位
38 0C           MOV R0, A
            
39 09           MOV A, R1
3A 44           RL A                          ; R1 左移一位
3B 0D           MOV R1, A
            
3C 781C         JMP LOOP6                     ; 跳转回 LOOP6 继续运算
            LOOP8:
3E 0A           MOV A, R2                     ; 将 R2 中的运算结果送入 A
3F 0F           MOV R3, A                     ; 将 A 中的值送入 R3（更新结果）
40 7849         JMP LOOP2                     ; 跳转至 LOOP2（执行底数平方）
            ; ============= 底数平方处理 =============
            LOOP11:                            ; 用于回跳
42 7081         MOV A, 81H                    ; 将主存地址 81H 的值送入 A（当前指数）
44 40           RR A                          ; 将 A 右移一位（指数右移）
45 1C81         MOV 81H, A                    ; 将更新后的指数写回主存地址 81H
47 780A         JMP LOOP1                     ; 返回主循环开始
            LOOP2:                             ; 实现底数平方的过程
49 0600         MOV R2, #00H                  ; 初始化 R2 寄存器用于存放乘法中间结果
4B 9080         MOV R0, 80H                   ; 将主存地址 80H 的值送入 R0（当前底数）
4D 9180         MOV R1, 80H                   ; 同样将主存地址 80H 的值送入 R1（乘数与被乘数一致）
            ; ============= 平方乘法子程序（R0 × R1 → R2） =============
            LOOP3:                             ; 运算结果存放在 R2 中
4F 08           MOV A, R0
50 20FF         AND A, #255
52 A471         JZ LOOP5                      ; 如果 R0 为 0，跳转至 LOOP5（乘法结束）
            
54 09           MOV A, R1
55 20FF         AND A, #255
57 A471         JZ LOOP5                      ; 如果 R1 为 0，跳转至 LOOP5（乘法结束）
            
59 08           MOV A, R0
5A 2001         AND A, #01H                   ; 检查 R0 最低位
5C A469         JZ LOOP4                      ; 最低位为 0，跳转至 LOOP4（不加）
            
5E 08           MOV A, R0
5F 40           RR A                          ; R0 右移一位
60 0C           MOV R0, A
            
61 0A           MOV A, R2
62 49           ADD A, R1                     ; R2 += R1
63 0E           MOV R2, A
            
64 09           MOV A, R1
65 44           RL A                          ; R1 左移一位
66 0D           MOV R1, A
            
67 784F         JMP LOOP3                     ; 跳转回 LOOP3 继续运算
            LOOP4:
69 08           MOV A, R0
6A 40           RR A                          ; R0 右移一位
6B 0C           MOV R0, A
            
6C 09           MOV A, R1
6D 44           RL A                          ; R1 左移一位
6E 0D           MOV R1, A
            
6F 784F         JMP LOOP3                     ; 跳转回 LOOP3 继续运算
            LOOP5:                             ; 乘法结束
71 9680         MOV 80H, R2                   ; 将 R2 中的运算结果送入主存地址 80H（更新底数）
73 7842         JMP LOOP11                    ; 跳转回主循环结尾
            ; ============= 程序结束 =============
            LOOPEND:
75 8C           NOP
76 7875         JMP LOOPEND                   ; 添加死循环终止程序
            
            
