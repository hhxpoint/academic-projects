            ; ============= 阶乘计算（查表法）=============
            ; 功能：通过预存查找表直接获取n!的结果
            ; 查找表存储在A0H~A5H，分别对应0!~5!
            ; 输入n存放在80H，结果存放在81H
            ; 优点：时间复杂度O(1)，无需循环计算
            ; ============= 查找表初始化 =============
00 1001     MOV A, #01H     ; 0! = 1
02 1C01     MOV A0H, A      ; 存入A0H
04 1001     MOV A, #01H     ; 1! = 1
06 1C01     MOV A1H, A      ; 存入A1H
08 1002     MOV A, #02H     ; 2! = 2
0A 1C01     MOV A2H, A      ; 存入A2H
0C 1006     MOV A, #06H     ; 3! = 6
0E 1C01     MOV A3H, A      ; 存入A3H
10 1018     MOV A, #18H     ; 4! = 24 (0x18)
12 1C01     MOV A4H, A      ; 存入A4H
14 1078     MOV A, #78H     ; 5! = 120 (0x78)
16 1C01     MOV A5H, A      ; 存入A5H
            ; ============= 输入与查表模块 =============
18 1005     MOV A, #05H     ; 输入n=5（可修改为0~5）
1A 1C80     MOV 80H, A      ; 存入80H
            
1C 7080     MOV A, 80H      ; 读取n值
1E 0C       MOV R0, A       ; R0=n（用作查找表索引）
1F 08       MOV A, R0       ; 计算查找表地址
20 5001     ADD A, #A0H     ; 地址=A0H+n
22 0D       MOV R1, A       ; R1=查找表地址
23 19       MOV A, @R1      ; 读取查找表中的n!值
24 1C81     MOV 81H, A      ; 结果存入81H
            ; ============= 结束 =============
            DONE:
26 8C           NOP
27 7826         JMP DONE    ; 死循环结束程序
            
