            ;=========================================================
            ; 程序2: 求 1+2+3+4+5+6+7+8 = 36 = 0x24
            ;---------------------------------------------------------
            ; 算法: 单层循环, 计数器 R0 从 8 递减到 0
            ;   每次把 R0 的当前值累加到 R1
            ; 寄存器分配:
            ;   R0 = 计数器 (8→0, 兼做加数)
            ;   R1 = 累加和 (0→36)
            ;   A  = 运算中转
            ;=========================================================
            
                    ORG  00H
00 1000             MOV  A, #00H
02 0D               MOV  R1, A          ; R1 = sum = 0
03 1008             MOV  A, #08H
05 0C               MOV  R0, A          ; R0 = 8 (计数)
            
06 09       LOOP:   MOV  A, R1          ; A = sum
07 48               ADD  A, R0          ; A = sum + R0
08 0D               MOV  R1, A          ; sum 更新
            
09 08               MOV  A, R0          ; R0--
0A 6001             SUB  A, #01H
0C 0C               MOV  R0, A
            
0D A411             JZ   DONE           ; R0==0 结束
0F 7806             JMP  LOOP
            
11 09       DONE:   MOV  A, R1          ; A = sum = 36 = 0x24
                                    ; 输出 0x24
12 7812     HALT:   JMP  HALT
                    END
