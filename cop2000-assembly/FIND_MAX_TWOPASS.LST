            ; ============================================================================
            ; FIND_MAX_TWOPASS.ASM - Version D
            ; 两趟扫描查找最大值汇编程序 (Two-Pass Scan for Maximum)
            ;
            ; 功能: 用两趟扫描在10个有符号8位数中查找最大值
            ;       (Find maximum of 10 signed 8-bit numbers using two-pass scan)
            ;
            ; 算法流程:
            ;   Phase 1: 数据输入与移码转换 (Data input & biased code conversion)
            ;            有符号数 -> 移码 (补码 + 80H), 存于 80H~89H
            ;   Phase 2: 第一趟扫描偶数下标 (Pass 1: scan even indices)
            ;            R0 从 80H 开始, 步长为 2, 扫描 80H, 82H, 84H, 86H, 88H
            ;   Phase 3: 第二趟扫描奇数下标 (Pass 2: scan odd indices)
            ;            R0 从 81H 开始, 步长为 2, 扫描 81H, 83H, 85H, 87H, 89H
            ;   Phase 4: 补码还原 (Convert max from biased code to two's complement)
            ;
            ; 测试数据: 100, -77, 42, 65, 17, -8, -32, 67, 4, 22
            ;
            ; 寄存器分配:
            ;   R0: 扫描指针 (Scan pointer)
            ;   R1: 当前趟的终止地址 (End boundary for current pass)
            ;   R2: 临时寄存器, 用于比较 (Temp for comparisons)
            ;
            ; 内存分配:
            ;   80H~89H: 移码数组 (Biased code array, 10 elements)
            ;   90H:     当前最大值 (Current maximum in biased code)
            ;   91H:     当前趟终止地址 (End address for current pass)
            ;   92H:     最大值-补码 (Maximum in two's complement)
            ; ============================================================================
            
            ; ============================================================================
            ; Phase 1: 数据输入模块 - 将10个有符号数转为移码并存入内存
            ; (Data Input Module - Convert signed numbers to biased code and store)
            ; ============================================================================
            
            ; --- 第1个数: 100 ---
00 1064         MOV A, #100     ; 将立即数100存入累加器A
02 5080         ADD A, #80H     ; 100 + 128 = 228 (0xE4), 转换为移码
04 1C80         MOV 80H, A      ; 将移码0xE4存入内存地址80H
            
            ; --- 第2个数: -77 ---
06 10B3         MOV A, #-77     ; -77 (补码: 0xB3)
08 5080         ADD A, #80H     ; 转换为移码: 0xB3 + 0x80 = 51 (0x33)
0A 1C81         MOV 81H, A      ; 存入81H
            
            ; --- 第3个数: 42 ---
0C 102A         MOV A, #42      ; +42
0E 5080         ADD A, #80H     ; 转换为移码: 42 + 128 = 170 (0xAA)
10 1C82         MOV 82H, A      ; 存入82H
            
            ; --- 第4个数: 65 ---
12 1041         MOV A, #65      ; +65
14 5080         ADD A, #80H     ; 转换为移码: 65 + 128 = 193 (0xC1)
16 1C83         MOV 83H, A      ; 存入83H
            
            ; --- 第5个数: 17 ---
18 1011         MOV A, #17      ; +17
1A 5080         ADD A, #80H     ; 转换为移码: 17 + 128 = 145 (0x91)
1C 1C84         MOV 84H, A      ; 存入84H
            
            ; --- 第6个数: -8 ---
1E 10F8         MOV A, #-8      ; -8 (补码: 0xF8)
20 5080         ADD A, #80H     ; 转换为移码: 0xF8 + 0x80 = 0x78
22 1C85         MOV 85H, A      ; 存入85H
            
            ; --- 第7个数: -32 ---
24 10E0         MOV A, #-32     ; -32 (补码: 0xE0)
26 5080         ADD A, #80H     ; 转换为移码: 0xE0 + 0x80 = 0x60
28 1C86         MOV 86H, A      ; 存入86H
            
            ; --- 第8个数: 67 ---
2A 1043         MOV A, #67      ; +67
2C 5080         ADD A, #80H     ; 转换为移码: 67 + 128 = 195 (0xC3)
2E 1C87         MOV 87H, A      ; 存入87H
            
            ; --- 第9个数: 4 ---
30 1004         MOV A, #4       ; +4
32 5080         ADD A, #80H     ; 转换为移码: 4 + 128 = 132 (0x84)
34 1C88         MOV 88H, A      ; 存入88H
            
            ; --- 第10个数: 22 ---
36 1016         MOV A, #22      ; +22
38 5080         ADD A, #80H     ; 转换为移码: 22 + 128 = 150 (0x96)
3A 1C89         MOV 89H, A      ; 存入89H
            
            ; ============================================================================
            ; Phase 2: 第一趟扫描 - 偶数下标 (Pass 1: Even Indices)
            ; 扫描 80H, 82H, 84H, 86H, 88H, 步长为 2
            ; 终止地址: R1 = 8AH (88H 的下一个地址)
            ; ============================================================================
            
3C 108A         MOV A, #8AH     ; 第一趟终止地址 (one past last even = 88H + 2)
3E 1C91         MOV 91H, A      ; 存储终止地址到 91H
40 0D           MOV R1, A       ; R1 = 8AH (用于循环边界比较)
            
41 0480         MOV R0, #80H    ; R0 = 80H (第一个偶数下标)
43 18           MOV A, @R0      ; 取第一个元素 arr[80H] 作为初始最大值
44 1C90         MOV 90H, A      ; 存入 90H 作为当前最大值
            
            ; --- 第一趟主循环 (Pass 1 Main Loop) ---
            PASS1:
46 08           MOV A, R0       ; 取当前扫描地址
47 5002         ADD A, #02H     ; 步长为 2: R0 = R0 + 2
49 0C           MOV R0, A       ; 更新扫描指针
            
4A 09           MOV A, R1       ; 取终止地址 8AH
4B 58           SUB A, R0       ; 计算 8AH - R0
4C A45A         JZ  PASS2       ; 若 R0 == 8AH, 第一趟结束, 跳转到第二趟
            
4E 18           MOV A, @R0      ; 取当前元素 arr[R0]
4F 0E           MOV R2, A       ; R2 = arr[R0] (暂存当前元素)
50 0A           MOV A, R2       ; 加载当前元素到 A
51 6490         SUB A, 90H      ; 比较: A = arr[R0] - 当前最大值
53 8058         JC  P1SKIP      ; 若 arr[R0] < 当前最大值 (CF=1), 跳过更新
            
55 0A           MOV A, R2       ; 重新加载当前元素 (SUB 修改了 A)
56 1C90         MOV 90H, A      ; 更新最大值为 arr[R0]
            
            P1SKIP:
58 7846         JMP PASS1       ; 继续第一趟扫描
            
            ; ============================================================================
            ; Phase 3: 第二趟扫描 - 奇数下标 (Pass 2: Odd Indices)
            ; 扫描 81H, 83H, 85H, 87H, 89H, 步长为 2
            ; 终止地址: R1 = 8BH (89H 的下一个地址)
            ; ============================================================================
            
            PASS2:
5A 108B         MOV A, #8BH     ; 第二趟终止地址 (one past last odd = 89H + 2)
5C 1C91         MOV 91H, A      ; 存储终止地址到 91H
5E 0D           MOV R1, A       ; R1 = 8BH (用于循环边界比较)
            
5F 0481         MOV R0, #81H    ; R0 = 81H (第一个奇数下标)
            
            ; --- 第二趟主循环 (Pass 2 Main Loop) ---
            PASS2L:
61 09           MOV A, R1       ; 取终止地址 8BH
62 58           SUB A, R0       ; 计算 8BH - R0
63 A475         JZ  CONVERT     ; 若 R0 == 8BH, 第二趟结束, 跳转到补码还原
            
65 18           MOV A, @R0      ; 取当前元素 arr[R0]
66 0E           MOV R2, A       ; R2 = arr[R0] (暂存当前元素)
67 0A           MOV A, R2       ; 加载当前元素到 A
68 6490         SUB A, 90H      ; 比较: A = arr[R0] - 当前最大值
6A 806F         JC  P2SKIP      ; 若 arr[R0] < 当前最大值 (CF=1), 跳过更新
            
6C 0A           MOV A, R2       ; 重新加载当前元素 (SUB 修改了 A)
6D 1C90         MOV 90H, A      ; 更新最大值为 arr[R0]
            
            P2SKIP:
6F 08           MOV A, R0       ; 取当前地址
70 5002         ADD A, #02H     ; 步长为 2: R0 = R0 + 2
72 0C           MOV R0, A       ; 更新扫描指针
73 7861         JMP PASS2L      ; 继续第二趟扫描
            
            ; ============================================================================
            ; Phase 4: 补码还原模块 (Convert Maximum to Two's Complement)
            ; 将移码形式的最大值转换回补码, 存入 92H
            ; 转换公式: 补码 = 移码 - 80H
            ; ============================================================================
            
            CONVERT:
75 7090         MOV A, 90H      ; 取最大值 (移码形式)
77 6080         SUB A, #80H     ; 移码转回补码 (移码 - 128 = 补码)
79 1C92         MOV 92H, A      ; 将补码结果存入 92H
            
            ; ============================================================================
            ; 程序结束 (Program End)
            ; ============================================================================
            
            LOOPEND:
7B 8C           NOP             ; 空操作
7C 787B         JMP LOOPEND     ; 死循环终止程序
            
