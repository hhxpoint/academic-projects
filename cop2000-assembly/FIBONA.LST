00 0405     MOV R0, #05H    ; 计算前5项
02 0500     MOV R1, #00H    ; F(0) = 0
04 0601     MOV R2, #01H    ; F(1) = 1
            LOOP:
06 08           MOV A, R0        ; A = 当前迭代次数
07 A416         JZ END_LOOP      ; A=0时结束循环
            
09 0A           MOV A, R2        ; A = F(n-1)
0A 49           ADD A, R1        ; A = F(n-1) + F(n-2)
0B 0F           MOV R3, A        ; 临时存F(n)到R3  tmp = pre + pre_pre
            
0C 0A           MOV A, R2        ; 保存R2到A
0D 0D           MOV R1, A        ; R1 = 旧R2      pre_pre = pre
0E 0B           MOV A, R3        ; 恢复F(n)到A
0F 0E           MOV R2, A        ; R2 = F(n)      pre = tmp
            
10 08           MOV A, R0
11 6001         SUB A, #01H
13 0C           MOV R0, A
            
14 7806         JMP LOOP         ; 继续循环
            END_LOOP:
16 8C           NOP
17 7816         JMP END_LOOP     ; 停机
            
            
