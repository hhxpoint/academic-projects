00 1064     MOV A, #100     ; 将立即数100存入累加器A
02 5080     ADD A, #80H     ; 100 + 128 = 228 (0xE4)，转换为移码（补码+128）
04 1C80     MOV 80H, A      ; 将移码0xE4存入内存地址80H
06 10B3     MOV A, #-77     ; 将立即数-77存入累加器A（汇编中负数以补码形式表示）
08 5080     ADD A, #80H     ; -77的补码(0xB3) + 128 = 51 (0x33)，转换为移码
0A 1C81     MOV 81H, A      ; 将移码0x33存入内存地址81H
0C 102A     MOV A, #42      ; +42
0E 5080     ADD A, #80H     ; 转换为移码：42 + 128 = 170 (0xAA)
10 1C82     MOV 82H, A      ; 存入82H
12 1041     MOV A, #65      ; +65
14 5080     ADD A, #80H     ; 转换为移码：65 + 128 = 193 (0xC1)
16 1C83     MOV 83H, A      ; 存入83H
18 1011     MOV A, #17      ; +17
1A 5080     ADD A, #80H     ; 转换为移码：17 + 128 = 145 (0x91)
1C 1C84     MOV 84H, A      ; 存入84H
1E 10F8     MOV A, #-8      ; -8（补码形式：0xF8）
20 5080     ADD A, #80H     ; 转换为移码：0xF8 + 0x80 = 0x78
22 1C85     MOV 85H, A      ; 存入85H
24 10E0     MOV A, #-32     ; -32（补码形式：0xE0）
26 5080     ADD A, #80H     ; 转换为移码：0xE0 + 0x80 = 0x60
28 1C86     MOV 86H, A      ; 存入86H
2A 1043     MOV A, #67      ; +67
2C 5080     ADD A, #80H     ; 转换为移码：67 + 128 = 195 (0xC3)
2E 1C87     MOV 87H, A      ; 存入87H
30 1004     MOV A, #4       ; +4
32 5080     ADD A, #80H     ; 转换为移码：4 + 128 = 132 (0x84)
34 1C88     MOV 88H, A      ; 存入88H
36 1016     MOV A, #22      ; +22
38 5080     ADD A, #80H     ; 转换为移码：22 + 128 = 150 (0x96)
3A 1C89     MOV 89H, A      ; 存入89H
            ; ============= 冒泡排序模块 =============
3C 0480     MOV R0, #80H    ; 初始化外循环上边界（数组起始地址）
3E 0589     MOV R1, #89H    ; 初始化外循环下边界（数组结束地址）
            LOOP1:          ; 外循环开始
40 09           MOV A, R1    ; 将外循环下边界地址存入累加器A
41 58           SUB A, R0    ; 计算R1 - R0
42 A465         JZ LOOPRE    ; 如果结果为0（R1=R0），表示排序完成，跳转到补码转换部分
            
44 08           MOV A, R0    ; 将外循环上边界地址存入累加器A
45 0E           MOV R2, A    ; 初始化内循环指针R2为外循环上边界
46 5001         ADD A, #01H  ; R2指针加1
48 0F           MOV R3, A    ; 初始化内循环指针R3为R2的下一个位置
            LOOP2:          ; 内循环开始
49 09           MOV A, R1    ; 将外循环下边界地址存入累加器A
4A 5A           SUB A, R2    ; 计算R1 - R2
4B A457         JZ LOOP11    ; 如果结果为0（R2=R1），表示内循环完成，跳转到外循环尾部
            
4D 1B           MOV A, @R3   ; 取R3指向的移码值
4E 5E           SUB A, @R2   ; 比较R3和R2指向的移码值
4F 805B         JC LOOP3     ; 如果R3的值 < R2的值（借位标志CF=1），跳转到交换部分
            LOOP22:         ; 内循环尾部
51 6A01         ADD R2, #01H ; R2指针加1
53 6B01         ADD R3, #01H ; R3指针加1
55 7849         JMP LOOP2    ; 继续内循环
            LOOP11:         ; 外循环尾部
57 6D01         SUB R1, #01H ; 外循环下边界减1
59 7840         JMP LOOP1    ; 继续外循环
            LOOP3:          ; 交换部分
5B 1A           MOV A, @R2   ; 取R2指向的值
5C 1C90         MOV 90H, A   ; 暂存到内存地址90H
5E 1B           MOV A, @R3   ; 取R3指向的值
5F 16           MOV @R2, A   ; 将R3的值赋给R2指向的位置
60 7090         MOV A, 90H   ; 从暂存处取回原值
62 17           MOV @R3, A   ; 将原值赋给R3指向的位置
63 7851         JMP LOOP22   ; 返回内循环尾部
            ; ============= 补码还原模块 =============
            LOOPRE:         ; 转换补码部分
65 0480         MOV R0, #80H ; 初始化循环上边界（原移码数组起始地址）
67 0589         MOV R1, #89H ; 初始化循环下边界（原移码数组结束地址）
            LOOP4:          ; 转码循环开始
69 09           MOV A, R1    ; 将当前处理的地址存入累加器A
6A 5010         ADD A, #10H  ; 计算目标地址（原地址+16）
6C 0E           MOV R2, A    ; 将目标地址存入R2
            
6D 19           MOV A, @R1   ; 取当前地址的移码值
6E 6080         SUB A, #80H  ; 移码转回补码（移码 - 128 = 补码）
70 16           MOV @R2, A   ; 将补码存入目标地址（90H~99H）
            
71 09           MOV A, R1    ; 将当前地址存入累加器A
72 58           SUB A, R0    ; 计算R1 - R0
73 A479         JZ LOOPEND   ; 如果结果为0（R1=R0），表示所有数据都已转换，跳转到结束
75 6D01         SUB R1, #01H ; 当前地址减1
77 7869         JMP LOOP4    ; 继续转换下一个数据
            LOOPEND:        ; 排序完成
79 8C           NOP
7A 7879         JMP LOOPEND  ; 加入死循环结束程序
            
            
            
