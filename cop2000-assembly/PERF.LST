0E 5B           SUB A, R3
0F 5B           SUB A, R3
10 8018         JC GOT_LIM
12 0B           MOV A, R3
13 5001         ADD A, #01H
15 0F           MOV R3, A
16 780C         JMP HLIM
            GOT_LIM:
18 0501         MOV R1, #01H
            DIV_LOOP:
1A 09           MOV A, R1
1B 5B           SUB A, R3
1C A43A         JZ CHK_PERF
1E 7080         MOV A, 80H
20 0E           MOV R2, A
            CHK_LOOP:
21 59           SUB A, R1
22 802B         JC NOT_DIV
24 0A           MOV A, R2
25 59           SUB A, R1
26 A431         JZ IS_DIV
28 0E           MOV R2, A
29 7821         JMP CHK_LOOP
            NOT_DIV:
