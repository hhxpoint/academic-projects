2C 5001         ADD A, #01H
2E 0D           MOV R1, A
2F 781A         JMP DIV_LOOP
            IS_DIV:
31 08           MOV A, R0
32 49           ADD A, R1
33 0C           MOV R0, A
34 09           MOV A, R1
35 5001         ADD A, #01H
37 0D           MOV R1, A
38 781A         JMP DIV_LOOP
            CHK_PERF:
