            ; ============= main 入口 =============
00 0430     MOV R0, #30H    ; R0 = 48（0x30）
02 0512     MOV R1, #12H    ; R1 = 18（0x12）
04 8808     CALL GCD        ; 调用 GCD 函数
            ; 结果存于 R0
            ; 无限循环结束
06 7806     JMP $
            ; ============= 递归实现 GCD =============
            GCD:
                ; 保存 R0-R1 到栈
08 08           MOV A, R0
09 17           MOV @R3, A
0A 0B           MOV A, R3
0B 5001         ADD A, #01H
0D 0F           MOV R3, A
            
0E 09           MOV A, R1
0F 17           MOV @R3, A
10 0B           MOV A, R3
11 5001         ADD A, #01H
13 0F           MOV R3, A
            
                ; 判断 R1 == 0 ?
14 09           MOV A, R1
15 802A         JC BASE_CASE
            
                ; 计算 R0 % R1
                ; 保存 R1 到 R2
17 09           MOV A, R1
18 0E           MOV R2, A
            
                ; 计算 R0 % R1（通过减法循环）
            MOD_LOOP:
19 08           MOV A, R0
1A 5A           SUB A, R2
1B 8020         JC MOD_DONE
1D 0C           MOV R0, A
1E 7819         JMP MOD_LOOP
            MOD_DONE:
                ; 保存余数到 R2
20 08           MOV A, R0
21 0E           MOV R2, A
            
                ; 更新 R0 = R1
22 09           MOV A, R1
23 0C           MOV R0, A
            
                ; 更新 R1 = R2（a % b）
24 0A           MOV A, R2
25 0D           MOV R1, A
            
                ; 递归调用 GCD(b, a % b)
26 8808         CALL GCD
            
                ; 返回后无需恢复 R0-R1（由递归调用栈处理）
                ; 跳转到返回点
28 7836         JMP RET_GCD
            BASE_CASE:
                ; 恢复 R1
2A 0B           MOV A, R3
2B 6001         SUB A, #01H
2D 0F           MOV R3, A
2E 1B           MOV A, @R3
2F 0D           MOV R1, A
            
                ; 恢复 R0
30 0B           MOV A, R3
31 6001         SUB A, #01H
33 0F           MOV R3, A
34 1B           MOV A, @R3
35 0C           MOV R0, A
            RET_GCD:
36 E0           RET
            
            
            
