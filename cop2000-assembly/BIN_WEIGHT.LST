00 7080     MOV A, 80H
02 0C           MOV R0, A    ; R0 用来暂存当前正在处理的数字
03 0500         MOV R1, #00H ; R1 用来当计数器，记录 '1' 的个数，初始化为0
            
            BW_LOOP:
                ; --- 1. 安全判定 R0 是否已经变为 0 ---
05 08           MOV A, R0
06 5000         ADD A, #00H  ; 【神级补丁】强制让 A 过一次 ALU，这样才能刷新硬件的 Z 标志！
08 A416         JZ BW_CLASS  ; 如果此时 A 是 0 (说明所有的 1 都被扣光了)，跳到分类阶段
                
                ; --- 2. 核心算法：消除最低位的一个 1 (n & n-1) ---
0A 6001         SUB A, #01H  ; 此时 A 里面是 R0 的值，A = n - 1
0C 0E           MOV R2, A    ; R2 暂存 (n - 1)
0D 08           MOV A, R0    ; A 重新拿回 n
0E 2A           AND A, R2    ; A = n AND (n - 1) -> 这个位运算能神奇地消掉最低位的一个 1
0F 0C           MOV R0, A    ; 把消掉一个 1 后的新数字存回 R0
                
                ; --- 3. 计数器安全 +1 ---
10 09           MOV A, R1    ; 把计数器请进 A
11 5001         ADD A, #01H  ; 计数器 +1
13 0D           MOV R1, A    ; 把计数器存回 R1
14 7805         JMP BW_LOOP  ; 继续循环找下一个 1
            
            BW_CLASS:
                ; 此时，R1 里已经完美记录了 80H 中 '1' 的个数。
                ; 分类规则： 0~2个(轻, 亮1)；3~5个(中, 亮2)；6~8个(重, 亮3)
                
16 09           MOV A, R1    ; 把个数放入 A 准备分类
17 6003         SUB A, #03H  ; 减去 3
19 8025         JC LIGHT     ; 如果产生借位 (说明个数是 0, 1, 2)，跳到轻级别
                
1B 6003         SUB A, #03H  ; 刚才已经减了3，现在再减3 (相当于总共减了6)
1D 802B         JC MEDIUM    ; 如果产生借位 (说明个数是 3, 4, 5)，跳到中级别
            
            HEAVY:
                ; 如果两次减3都不借位，说明个数 >= 6，属于重级别
1F 1003         MOV A, #03H  
21 1C81         MOV 81H, A   ; 输出 03 到地址 81H
23 782F         JMP END_B
            
            LIGHT:
25 1001         MOV A, #01H
27 1C81         MOV 81H, A   ; 输出 01 到地址 81H
29 782F         JMP END_B
            
            MEDIUM:
2B 1002         MOV A, #02H
2D 1C81         MOV 81H, A   ; 输出 02 到地址 81H
            
            END_B:
2F 8C           NOP
30 782F         JMP END_B    ; 停机
            
