            ; 功能：对 80H 单元字符执行大写字母 +3 循环凯撒加密，非大写字母原样输出
            ; 输入：80H 单元待处理字符
            ; 输出：81H 单元加密结果
            ; 寄存器规划：R0=加密结果暂存  R1=原始字符主备份  R2=中间运算暂存
            
            START:
                ; ========== 阶段1：读取输入并多份备份 ==========
00 7080         MOV A, 80H    ; 从 80H 地址读取待处理字符
02 0D           MOV R1, A     ; R1 保存原始字符主备份，非字母场景直接复用
03 0E           MOV R2, A     ; R2 保存原始字符副备份，用于下界校验运算
            
                ; ========== 阶段2：输入合法性下界校验 ==========
                ; 判断字符是否小于 'A' (ASCII 41H)，小于则视为非大写字母
04 0A           MOV A, R2     ; 加载原始字符到累加器
05 6041         SUB A, #41H   ; 执行减法：字符 - 'A'
07 800E         JC  SAVE_ORIGIN ; 产生借位 → 字符 < 'A' → 跳转至原样保存分支
            
                ; ========== 阶段3：输入合法性上界校验 ==========
                ; 判断字符是否大于 'Z' (ASCII 5AH)，大于则视为非大写字母
09 09           MOV A, R1     ; 重新加载原始字符
0A 605B         SUB A, #5BH   ; 执行减法：字符 - ('Z' + 1)，5BH 为 'Z' 的下一个ASCII码
0C 8011         JC  DO_ENCRYPT ; 产生借位 → 字符 ≤ 'Z' → 是合法大写字母，进入加密流程
            
                ; ========== 阶段4：非大写字母分支：直接保存原始值 ==========
            SAVE_ORIGIN:
0E 09           MOV A, R1     ; 取出原始字符
0F 7830         JMP STORE_RESULT ; 跳转到统一保存入口
            
                ; ========== 阶段5：合法大写字母：分步执行 +3 加密 ==========
            DO_ENCRYPT:
11 09           MOV A, R1     ; 重新加载原始字符
12 5001         ADD A, #01H   ; 第一步偏移：+1
14 0E           MOV R2, A     ; 暂存第一步偏移结果
15 0A           MOV A, R2     ; 取出第一步偏移结果
16 5002         ADD A, #02H   ; 第二步偏移：+2，累计偏移 +3
18 0C           MOV R0, A     ; R0 暂存 +3 后的完整加密值，避免后续比较破坏
            
                ; ========== 阶段6：加密后溢出判断（是否超出 'Z'） ==========
19 605B         SUB A, #5BH   ; 计算：加密后字符 - 5BH
1B 802F         JC  NO_WRAP   ; 产生借位 → 未超出 'Z' → 无需循环折返
            
                ; ========== 阶段7：溢出处理：分步执行字母表循环折返 ==========
            WRAP_PROCESS:
1D 08           MOV A, R0     ; 恢复 +3 后的原始加密值
1E 6010         SUB A, #10H   ; 第一步折返：减去 16 (10H)
20 600A         SUB A, #0AH   ; 第二步折返：减去 10 (0AH)，累计减去 26 (1AH)
22 0C           MOV R0, A     ; 将折返后的结果回存到 R0
            
                ; ========== 阶段8：防御性双重校验（确保结果落在 A-Z 区间） ==========
                ; 校验下界：结果是否 ≥ 'A'
23 08           MOV A, R0
24 6041         SUB A, #41H
26 8011         JC  DO_ENCRYPT ; 下界异常 → 重新执行加密流程（防御性兜底）
            
                ; 校验上界：结果是否 ≤ 'Z'
28 08           MOV A, R0
29 605B         SUB A, #5BH
2B 802F         JC  CHECK_PASS ; 上界正常 → 校验通过
2D 781D         JMP WRAP_PROCESS ; 上界异常 → 重新执行折返
            CHECK_PASS:
            
                ; ========== 阶段9：无需折返分支 ==========
            NO_WRAP:
2F 08           MOV A, R0     ; 从 R0 恢复最终加密结果
            
                ; ========== 阶段10：统一保存结果到输出单元 ==========
            STORE_RESULT:
30 1C81         MOV 81H, A    ; 将最终结果写入 81H 存储单元
            
                ; ========== 阶段11：程序停机占位 ==========
            DONE:
32 8C           NOP           ; 空操作占位1
33 8C           NOP           ; 空操作占位2
34 8C           NOP           ; 空操作占位3
35 8C           NOP           ; 空操作占位4
36 7832         JMP DONE      ; 死循环，模拟程序停机
            
